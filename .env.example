# VKU Field Survey — Environment Variables
# Copy this file to .env.local and fill in your values

# Cloudflare Worker API URL (after deploying with wrangler)
# Format: https://<your-worker-name>.<your-account>.workers.dev
VITE_API_URL=/api/surveys

# Uncomment and set this after running `wrangler deploy`
# VITE_API_URL=https://vku-survey-api.your-account.workers.dev
